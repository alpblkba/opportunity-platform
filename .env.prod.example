# Copy to .env.prod on the server and fill it in. .env.prod is git-ignored and must never be
# committed, and nothing in this file may ever hold a real value.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Every variable below is read by docker-compose.prod.yml or docker-compose.e2micro.yml. A missing
# one is not a default: the application refuses to start rather than guess about who may reach it.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# POSTGRES_USER and POSTGRES_DB are used by the database container and to build DATABASE_URL, so
# they have to agree with each other and are easiest left alone.
POSTGRES_USER=opportunity
POSTGRES_DB=opportunity

# Generate with:  openssl rand -hex 24
#
# Hexadecimal on purpose. This password is embedded in a URL
# (postgres://user:password@db:5432/db), so anything needing percent-encoding there fails at the
# first connection: `+` becomes a space, `/` ends the authority, `@` splits it. Base64 produces all
# three. Keep it to A-Z a-z 0-9 . _ ~ - and the question never arises.
#
# It is applied once, when the database volume is created. Changing it later does nothing inside
# PostgreSQL and breaks the application; change it with ALTER ROLE first, then here.
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24

# How many connections the application holds open. Four is enough for one person browsing while a
# refresh runs, and each backend the server does not fork is several megabytes it keeps.
DATABASE_MAX_CONNECTIONS=4

# ---------------------------------------------------------------------------
# Cloudflare Access: who is allowed in
# ---------------------------------------------------------------------------
# The application validates the Access assertion itself, so the tunnel is not the only thing
# standing between the internet and your CV. It also refuses to listen on a non-loopback address
# unless these are set, which is why a misconfiguration stops the process instead of exposing it.
#
# CF_ACCESS_TEAM_DOMAIN  your Zero Trust team hostname, for example something.cloudflareaccess.com
# CF_ACCESS_AUD          the Application Audience tag on the Access application's Overview page
# ACCESS_ALLOWED_EMAILS  comma-separated. An empty list is refused rather than meaning everyone.
#
# ACCESS_MODE is the trust boundary, and changing it is the cutover described in
# docs/AUTHENTICATION.md. One of:
#   cloudflare  Cloudflare Access alone decides. What production runs today, and the rollback.
#   both        Cloudflare Access AND a native session. The rung in between: the login page is
#               exercised in production with nothing opened, because Cloudflare is still in front.
#   native      A native session alone. Only correct once the Access policy has been narrowed to
#               match, or the login page is behind an OTP nobody outside the policy can pass.
#   loopback    No identity layer. Refused on any address but 127.0.0.1.
# The Cloudflare variables below are required by cloudflare and both, and ignored by native.
ACCESS_MODE=cloudflare
CF_ACCESS_TEAM_DOMAIN=REPLACE_WITH_TEAM_DOMAIN
CF_ACCESS_AUD=REPLACE_WITH_APPLICATION_AUDIENCE_TAG
ACCESS_ALLOWED_EMAILS=REPLACE_WITH_YOUR_EMAIL

# ---------------------------------------------------------------------------
# Cloudflare Tunnel: how traffic arrives
# ---------------------------------------------------------------------------
# The token from the tunnel's install screen in Zero Trust. It is a secret and it identifies the
# connector. Route the tunnel's public hostname to http://app:8787 on the compose network; the
# container needs no inbound firewall rule because it dials out.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# ---------------------------------------------------------------------------
# Which image to run
# ---------------------------------------------------------------------------
# Maintained by scripts/deploy-vm.sh, which writes the tag it just loaded. It lives here rather than
# in the deploy command because sudo resets the environment, and a reboot should bring back the
# version that was deployed rather than whatever `latest` points at.
APP_IMAGE=opportunity-app:latest

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------
# How many opportunities are scored per request. The shortlist is held in memory with its
# descriptions, at roughly 4 KB each. When the catalogue outgrows this the ranking says so rather
# than quietly scoring a subset.
MATCH_SHORTLIST=2000

# Semantic ranking stays off on a 1 GiB machine: a model does not fit, and the owner's laptop must
# not become a dependency of the server. Without a provider the matcher ranks lexically and says so;
# it never claims a model ran.
EMBEDDINGS_PROVIDER=disabled
EMBEDDINGS_ENDPOINT=
EMBEDDINGS_MODEL=

RUST_LOG=info
