# Copy to .env locally (ignored by git). No real secrets in tracked files.
DATABASE_URL=postgres://opportunity:opportunity_local_dev@127.0.0.1:5432/opportunity
API_HOST=127.0.0.1
API_PORT=8787
WEB_PORT=5173
PUBLIC_SOURCE_REFRESH_HOURS=6
APPLICATION_AUTO_SUBMIT=false
# Optional: configure one LLM provider, or local Ollama. Never upload private profile by default.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_ALLOW_PRIVATE_PROFILE_UPLOAD=false
EMBEDDINGS_PROVIDER=local
