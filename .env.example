# Copy to .env locally (ignored by git). No real secrets in tracked files.
DATABASE_URL=postgres://opportunity:opportunity_local_dev@127.0.0.1:5432/opportunity
ACCESS_MODE=native
API_HOST=127.0.0.1
API_PORT=8787
WEB_PORT=5173
PUBLIC_SOURCE_REFRESH_HOURS=6
# Optional email delivery. Leave empty until configured by the owner.
MAIL_API_URL=https://api.resend.com
MAIL_API_KEY=
MAIL_FROM=
MAIL_TO=
# Set development for tests: real employer submission is then always refused.
APPLICATION_ENV=local
