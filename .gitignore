# Local personal data (including EPOCH-style local agent traces).
#
# Both forms on purpose: /private/ is the one at the root, and **/private/ catches the ones a
# component writes beside itself. apps/browser-worker/private/browser holds screenshots of filled
# forms - raw browser artifacts, which the contract keeps out of Git - and the root-anchored rule
# alone would have committed them.
/private/
**/private/
.env
.env.*
!.env.example
!.env.prod.example
/target/
/node_modules/
**/node_modules/
**/dist/
**/coverage/
*.sqlite
*.sqlite3
*.db
*.dump
# Backup output: the dumps hold the CV and the application history, and their checksums are no use without them.
/backups/
*.pem
*.key
*.p12
*.pfx
# Short-lived credentials google-github-actions/auth writes into the deploy job's checkout. Ignored
# so the build's clean-checkout check judges the reviewed source, not the job's own login.
gha-creds-*.json
*.docx
*.pdf
*.pages
*.rtf
# Explicitly sanitized/synthetic binary test fixtures; never use real CVs.
!/tests/fixtures/**/*.docx
!/tests/fixtures/**/*.pdf
!/tests/fixtures/*.docx
!/tests/fixtures/*.pdf
!**/tests/fixtures/**/*.docx
!**/tests/fixtures/**/*.pdf
!**/tests/fixtures/*.docx
!**/tests/fixtures/*.pdf
# Downloaded third-party tooling. The gcloud CLI is 52 MB compressed and 396 MB extracted; it is
# installed on a machine, not carried in a repository, and `git add -A` would otherwise take it.
/google-cloud-sdk/
google-cloud-cli-*.tar.gz
google-cloud-cli-*.zip
# Release archives built by scripts/release-image.sh. Regenerable, and hundreds of megabytes each.
/dist/
# macOS resource forks, written whenever this tree is copied to a non-APFS volume or archived.
._*
.AppleDouble/

.DS_Store
__pycache__/
*.pyc
# Agent plugin preferences are local to the developer's machine.
.claude/

# Local agent instructions and state.
/Self-Docs/
/self-docs/
/.claude/
/.codex/
/.cursor/
/AGENTS.md
/CLAUDE.md

# Internal development documents.
/prompts/
/BUILD_FULL_PRODUCT.md
/ONE_PROMPT_FOR_CLAUDE.txt
/SESSION_PLAN.md
/SCOPE_LOCK.md
/ACCEPTANCE_MATRIX.md
/PROGRESS.md
/RELEASE_VALIDATION.md
/RUNBOOK.md

# Internal reviews and deployment records.
/docs/PRE_COMMIT_REVIEW.md
/docs/GCP_DEPLOYMENT.md
/docs/E2_MICRO_AUDIT.md
# Generated review artefacts: diff snapshots duplicate commits kept in the history and the backup bundle.
/docs/implementation/review/*.patch
